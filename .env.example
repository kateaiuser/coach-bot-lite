# Скопируй в .env (локально) или впиши эти переменные в Railway.
# Ничего из этого не коммить в гит.

# Токен от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=

# Ключ Claude с console.anthropic.com (обязательно). Пополни баланс ~$5.
ANTHROPIC_API_KEY=

# Кому бот отвечает: твой Telegram user id (узнай у @userinfobot).
# Можно несколько через запятую. ВАЖНО: оставишь пустым — бот ответит ЛЮБОМУ,
# и чужие будут тратить твой баланс. Для личного коуча впиши свой id.
ALLOWED_USER_IDS=

# Личность коуча (ПРИВАТНО). Вставь сюда промпт своего коуча с практикума.
# Задавай это в Railway → Variables, тогда личное не попадёт в публичный репозиторий.
# Если задано, имеет приоритет над файлом personality.md.
COACH_PROMPT=

# Необязательное
MODEL=claude-sonnet-4-6        # дешевле: claude-haiku-4-5
MAX_TOKENS=1024
HISTORY=12                     # сколько последних реплик помнить в рамках сессии
